{
  "manifest_version": 3,
  "name": "Interface",
  "version": "3.0.0",
  "description": "Extension interface testing",
  "author": "Miish",
  "homepage_url": "https://github.com/hw-scripts/interface",
  "content_scripts": [
    {
      "matches": [
        "https://www.hero-wars.com/*"
      ],
      "js": [
        "manifest.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://www.hero-wars.com/*"
      ],
      "js": [
        "interface.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "host_permissions": [
    "https://*/*"
  ]
}