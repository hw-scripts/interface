{
  "manifest_version": 3,
  "name": "Interface",
  "version": "3.1.13",
  "description": "Extension interface testing",
  "author": "Miish",
  "homepage_url": "https://github.com/hw-scripts/interface",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.hero-wars.com/*"
      ],
      "js": [
        "interface.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.hero-wars.com/*"
      ],
      "js": [
        "manifest.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "locales/*.json"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "host_permissions": [
    "https://*/*"
  ]
}
